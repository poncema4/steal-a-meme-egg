{
  "name": "StealAMemeEgg",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Models": {
        "$className": "Folder",
        "Pets": {
          "$path": "src/models/Pets"
        },
        "Eggs": {
          "$path": "src/models/Eggs"
        },
        "Icons": {
          "$path": "src/models/Icons"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "MaxPlayers": 8
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "Models": {
        "$path": "src/models"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512,
        "StreamingIntegrityMode": "MinimumRadiusPause"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Brightness": 1.6,
        "ClockTime": 14.5,
        "GeographicLatitude": 30,
        "Ambient": [
          0.22,
          0.24,
          0.28
        ],
        "OutdoorAmbient": [
          0.32,
          0.34,
          0.38
        ],
        "ExposureCompensation": 0,
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.25,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25
      }
    }
  }
}
